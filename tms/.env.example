TMS_ADMIN_PASSWORD=ReplaceThisAdminPassword1!
TMS_ADMIN_NAME=Sandbox Admin
TMS_DISPATCHER_EMAIL=dispatcher@example.com
TMS_DISPATCHER_PASSWORD=ReplaceThisDispatcherPassword1!
TMS_DISPATCHER_NAME=Sandbox Dispatcher
TMS_VIEWER_EMAIL=viewer@example.com
TMS_VIEWER_PASSWORD=ReplaceThisViewerPassword1!
TMS_VIEWER_NAME=Sandbox Viewer
AZURE_RESOURCE_GROUP=tms-sandbox-rg
